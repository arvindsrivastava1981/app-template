# App URL (used for auth email links and cookie domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Database (Neon Postgres or any PostgreSQL)
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# JWT session secret — generate a strong random string, e.g. openssl rand -base64 32
JWT_SECRET=change-me-with-a-long-random-secret

# Resend (transactional email: verification + password reset)
RESEND_API_KEY=re_1234567890
EMAIL_FROM=App Template <no-reply@yourdomain.in>
